{
  "name": "spectorclient-launcher",
  "version": "1.6.24",
  "description": "SpectorClient Electron launcher for Windows and Linux with selectable Minecraft 26.2, 26.3 and 1.21.11 Fabric clients, isolated mods, shared client settings/resource packs/shader packs, managed Java 25/21, native desktop notifications, and automatic direct-to-latest updates",
  "main": "src/main.js",
  "author": "SpectorClient",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable",
    "fetch-brand": "node scripts/fetch-brand.js",
    "prestart": "npm run fetch-brand",
    "predist": "npm run fetch-brand",
    "predist:win": "npm run fetch-brand",
    "predist:portable": "npm run fetch-brand",
    "release:win": "npm run fetch-brand && electron-builder --win nsis --publish never",
    "build:release": "npm run release:win",
    "dist:linux": "electron-builder --linux AppImage --x64",
    "predist:linux": "npm run fetch-brand",
    "release:linux": "npm run fetch-brand && electron-builder --linux AppImage --x64 --publish never",
    "build:release:linux": "npm run release:linux"
  },
  "dependencies": {
    "minecraft-launcher-core": "3.18.2",
    "prismarine-auth": "3.1.1",
    "skinview3d": "3.4.2",
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "pngjs": "7.0.0"
  },
  "build": {
    "appId": "client.spector.launcher",
    "productName": "SpectorClient",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "SpectorClient-${version}-${arch}.${ext}",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SpectorClient",
      "include": "build/installer.nsh"
    },
    "publish": {
      "provider": "github",
      "owner": "NoobIsADev",
      "repo": "SpectorClient-Launcher",
      "releaseType": "release"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "SpectorClient-${version}-x86_64.${ext}",
      "icon": "build/icon.png",
      "category": "Game",
      "synopsis": "SpectorClient Minecraft launcher",
      "description": "SpectorClient Minecraft launcher with Fabric clients, mod management, managed Java runtimes, Microsoft sign-in, logs, themes, and automatic updates.",
      "desktop": {
        "entry": {
          "Name": "SpectorClient",
          "Comment": "Launch SpectorClient for Minecraft",
          "Categories": "Game;",
          "StartupWMClass": "SpectorClient",
          "Terminal": false,
          "Type": "Application"
        }
      }
    },
    "appImage": {
      "artifactName": "SpectorClient-${version}-x86_64.${ext}"
    },
    "toolsets": {
      "appimage": "1.0.3"
    }
  }
}
